<style>
  .status-hud {
    width: 480px;
    height: 84px;
    padding: 10px;
    gap: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    opacity: 0.28;
    pointer-events: none;
  }

  .status-cell {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .status-glow {
    position: absolute;
    width: 46px;
    height: 46px;
    border-radius: 23px;
    opacity: 0.12;
    transform-translate-z: 2px;
    pointer-events: none;
  }

  .status-icon {
    width: 30px;
    height: 30px;
    opacity: 0.68;
    transform-translate-z: 7px;
    pointer-events: none;
  }
</style>

<Panel id="status-projection-root" class="status-hud">
  <Container class="status-cell">
    <Container id="status-camera-glow" class="status-glow"></Container>
    <Camera id="status-camera-icon" class="status-icon"></Camera>
  </Container>
  <Container class="status-cell">
    <Container id="status-xr-glow" class="status-glow"></Container>
    <Glasses id="status-xr-icon" class="status-icon"></Glasses>
  </Container>
  <Container class="status-cell">
    <Container id="status-recorder-glow" class="status-glow"></Container>
    <CircleDot id="status-recorder-icon" class="status-icon"></CircleDot>
  </Container>
  <Container class="status-cell">
    <Container id="status-prompt-glow" class="status-glow"></Container>
    <MessageSquareText id="status-prompt-icon" class="status-icon"></MessageSquareText>
  </Container>
  <Container class="status-cell">
    <Container id="status-voice-glow" class="status-glow"></Container>
    <AudioLines id="status-voice-icon" class="status-icon"></AudioLines>
  </Container>
  <Container class="status-cell">
    <Container id="status-storage-glow" class="status-glow"></Container>
    <HardDrive id="status-storage-icon" class="status-icon"></HardDrive>
    <Upload id="status-upload-icon" class="status-icon"></Upload>
  </Container>
</Panel>
